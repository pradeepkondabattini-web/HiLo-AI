# auth-service environment (copy to .env for local dev; NEVER commit the real .env).
# Secrets belong in Secret Manager / Cloud Run env in production (EOS-000 §71).

# --- Required ---
FIREBASE_PROJECT_ID=hilo-23078

# --- Runtime (optional; sensible defaults) ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# --- Local Firebase Emulator Suite ---
# When these are set, the Admin SDK talks to the emulators and needs NO credentials.
# Ports match the root firebase.json.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Real Firebase (deploy / non-emulator) ---
# Do NOT set the emulator hosts above. Provide Application Default Credentials instead:
#   - Cloud Run: the service account is automatic (leave GOOGLE_APPLICATION_CREDENTIALS unset).
#   - Local against real project: point to a service-account key file that is GIT-IGNORED.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
