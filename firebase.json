{
  "//": "Root Firebase config so the Firebase CLI / MCP server (which expect firebase.json at the repo root) discover our project. Rule/index sources live in firebase/ per the monorepo layout (ADR-007) and are referenced here.",
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "hosting": {
    "public": "flutter-app/build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "//": "The bare collection path AND everything under it — a `/x/**` glob alone does NOT match `/x` itself, which broke list/create endpoints.",
        "source": "/api/v1/auth{,/**}",
        "run": { "serviceId": "auth-service", "region": "asia-south1" }
      },
      {
        "source": "/api/v1/events{,/**}",
        "run": { "serviceId": "event-service", "region": "asia-south1" }
      },
      {
        "source": "/api/v1/venues{,/**}",
        "run": { "serviceId": "venue-service", "region": "asia-south1" }
      },
      {
        "source": "/api/v1/vendors{,/**}",
        "run": { "serviceId": "vendor-service", "region": "asia-south1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
